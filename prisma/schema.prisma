model Complaint {
  id            String          @id @default(cuid())
  orderId       String
  userId        String
  assignedToId  String?
  subject       String
  description   String
  images        String[]
  status        ComplaintStatus @default(OPEN)
  resolution    String?
  rejectionNote String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id])
  user          User            @relation("CustomerComplaints", fields: [userId], references: [id])
  assignedTo    User?           @relation("ComplaintAssignee", fields: [assignedToId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@map("complaints")
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model ReturnRequest {
  id                  String       @id @default(cuid())
  orderId             String
  userId              String
  storeId             String?
  type                ReturnType   @default(REFUND)
  reason              String
  reasonLabel         String?
  description         String
  images              String[]
  videoUrl            String?
  bankName            String?
  bankAccountNumber   String?
  bankAccountName     String?
  refundAmount        Float?
  status              ReturnStatus @default(PENDING)
  storeResponse       String?
  returnCourier       String?
  returnTrackingNumber String?
  resolvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                User         @relation("CustomerReturnRequests", fields: [userId], references: [id])
  store               Store?       @relation(fields: [storeId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@map("return_requests")
}

enum ReturnType {
  REFUND
  REPLACEMENT
}

enum ReturnStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}