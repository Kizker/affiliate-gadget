# ================================================================
# Affiliate Gadget - Production Environment (Hostinger VPS)
# ================================================================
# RENAME file ini: cp .env.production.example .env.production
# Isi semua nilai yang kosong sebelum deploy!
# ================================================================

NODE_ENV=production

# ── App URL (ganti dengan domain Anda) ─────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME="Affiliate Gadget"

# ── Database PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=agadget
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_KUAT_DISINI
POSTGRES_DB=affiliate_gadget
DATABASE_URL=postgresql://agadget:GANTI_PASSWORD_DB_KUAT_DISINI@postgres:5432/affiliate_gadget?schema=public

# ── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=GANTI_PASSWORD_REDIS_KUAT_DISINI
REDIS_URL=redis://:GANTI_PASSWORD_REDIS_KUAT_DISINI@redis:6379

# ── Auth Secrets (generate baru!) ──────────────────────────────
# Cara generate: openssl rand -hex 32
NEXTAUTH_SECRET=GANTI_DENGAN_RANDOM_SECRET_64_KARAKTER
AUTH_SECRET=GANTI_DENGAN_RANDOM_SECRET_64_KARAKTER

# ── WhatsApp CS ─────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_CS=6281234567890

# ── Google OAuth (opsional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (upload foto/video produk & unboxing) ───────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment Gateway Midtrans ────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# ── Maps & Editor ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_TINYMCE_API_KEY=
