# ================================================================
# Production Environment Configuration Template
# Affiliate Gadget Platform (Example Only - Generic Placeholders)
# ================================================================

# --- Application Configuration ---
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME="Affiliate Gadget"

# --- Database (PostgreSQL PostGIS via Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=affiliate_gadget
DATABASE_URL=postgresql://postgres:your_db_password_here@postgres:5432/affiliate_gadget?schema=public

# --- Redis (Cache & Realtime) ---
REDIS_URL=redis://redis:6379

# --- Authentication (NextAuth.js v5) ---
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate_your_own_secret_with_openssl
AUTH_SECRET=generate_your_own_secret_with_openssl

# --- Admin Contact & Hotline ---
ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_WHATSAPP_CS=6281234567890

# --- Integrations (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
RESEND_API_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
